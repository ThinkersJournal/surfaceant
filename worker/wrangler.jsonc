{
  "name": "surfaceant-worker",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-01",
  "build": { "command": "worker-build --release" },
  "durable_objects": { "bindings": [{ "name": "CHANNEL", "class_name": "Channel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Channel"] }],
  // Limits (docs/DESIGN.md section 4). Secrets CHANNEL_KEY and ADMIN_SECRET are set with `wrangler secret put`, never in git.
  "vars": {
    "MAX_BODY_BYTES": "1048576",
    "BUFFER_TTL_SECONDS": "86400",
    "BUFFER_MAX_EVENTS": "1000",
    "BUFFER_MAX_BYTES": "67108864",
    "RATE_PER_SEC": "10",
    "RATE_BURST": "50",
    "WINDOW": "16"
  }
}
